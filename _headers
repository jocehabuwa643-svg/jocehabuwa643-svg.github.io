# Заголовки для Cloudflare Pages и Netlify (формат _headers у них общий). На Vercel — vercel.json.
# CSP встраивается в index.html при сборке (build/csp.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(self), screen-wake-lock=(self), payment=(), usb=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
